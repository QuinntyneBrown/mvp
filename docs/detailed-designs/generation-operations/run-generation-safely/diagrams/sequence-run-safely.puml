@startuml
title UML sequence behaviour — Complete, replace, or cancel generation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Consumer" as actor
participant "Command action" as command
participant "CliExceptionPolicy" as policy
participant "Generator" as generator
participant "TransactionalGenerationOutput" as output
participant "ProcessRunner" as process
database "Target / stage / backup" as files
actor -> command : Start generation
command -> policy : ExecuteAsync(operation, cancellationToken)
policy -> generator : GenerateAsync(validated input, token)
generator -> output : CommitAsync(target, force, render, token)
output -> files : Create sibling stage
output -> generator : Render(stage, token)
opt --use-angular-cli
  generator -> process : RunAsync(argument list, token)
  alt cancelled
    process -> process : Kill(entireProcessTree: true)
    process --> generator : OperationCanceledException
  end
end
alt completed
  output -> files : Move target to backup when forced
  output -> files : Move stage to target
  output -> files : Delete backup
  output --> generator : GenerationResult
  policy --> command : Exit 0
else failed or cancelled
  output -> files : Restore backup and delete stage
  policy --> command : Exit 1 / 2 / 3 / 70 / 130
end
command --> actor : Progress and bounded outcome
@enduml
