@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Run generation safely

Container_Boundary(run, "mvp generation run") {
  Component(command, "Command action", "System.CommandLine", "Reports progress and owns invocation token")
  Component(policy, "CliExceptionPolicy", ".NET policy", "Maps typed failures to stable exit codes")
  Component(generator, "Generator", ".NET service", "Plans and renders the selected tree")
  Component(transaction, "TransactionalGenerationOutput", ".NET file adapter", "Stages, backs up, commits, and rolls back")
  Component(writer, "SafeFileWriter", ".NET file adapter", "Enforces containment, UTF-8, and LF")
  Component(process, "ProcessRunner", ".NET process adapter", "Uses ArgumentList and kills child trees")
}
System_Ext(angular, "Angular CLI", "Explicit optional child process")
ComponentDb(files, "Local work area", "File system", "Consumer input and committed output")

Rel(command, policy, "Runs through")
Rel(policy, generator, "Invokes")
Rel(generator, transaction, "Requests commit")
Rel(transaction, writer, "Provides staging root to")
Rel(writer, files, "Writes contained staged files")
Rel(transaction, files, "Publishes / rolls back")
Rel(generator, process, "Uses only on opt-in")
Rel(process, angular, "Runs without a shell")
@enduml
