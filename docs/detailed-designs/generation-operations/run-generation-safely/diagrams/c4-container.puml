@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Run generation safely

Person(consumer, "Consumer", "Observes progress and outcomes")
System_Boundary(mvp, "mvp") {
  Container(cli, "CLI process", ".NET / System.CommandLine", "Owns invocation and exit outcome")
  Container(generators, "Generator services", ".NET", "Create selected artifacts with cancellation")
  Container(output, "Transactional output", ".NET file APIs", "Stages, backs up, commits, and rolls back")
  Container(process, "Child-process adapter", ".NET Process", "Runs optional tooling without a shell")
}
System_Ext(angular, "Angular CLI", "Optional frontend generator")
ContainerDb(files, "Local work area", "File system", "Input manifests and output trees")

Rel(consumer, cli, "Starts or interrupts")
Rel(cli, generators, "Dispatches input and cancellation")
Rel(cli, output, "Receives structured result from")
Rel(generators, process, "Runs optional tooling through")
Rel(process, angular, "Starts and observes")
Rel(generators, output, "Renders through")
Rel(output, files, "Stages and publishes")
@enduml
