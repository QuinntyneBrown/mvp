@startuml
title UML sequence behaviour — Load and resolve a manifest
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Consumer" as actor
box "Frontend — Operating-system shell" #E0F2FE
  participant "mvp invocation" as shell
end box
box "Backend — mvp CLI application" #D1FADF
  participant "Full-stack action" as command
  participant "YamlManifestLoader" as loader
  participant "ManifestValidator" as validator
end box
box "Backend — Scaffolding application" #ECFDF3
  participant "IFullStackGenerator" as generator
end box
database "Manifest file" as file
actor -> shell : Supply --config and overrides
shell -> command : Dispatch parsed values
command -> loader : Load(configPath)
loader -> file : Read bounded YAML data
file --> loader : YAML content
loader -> loader : Deserialize and collect unknown-field warnings
loader --> command : ManifestLoadResult
command -> validator : Validate(dto, overrides, warnings)
validator -> validator : Aggregate names, types, routes, libraries, duplicates
alt valid
  validator --> command : ValidatedManifest
  command -> generator : GenerateAsync(validated manifest)
  command --> shell : Continue generation
else invalid
  validator --> command : ManifestValidationException(all errors)
  command --> shell : Exit 1 without filesystem changes
end
shell --> actor : Present outcome
@enduml
