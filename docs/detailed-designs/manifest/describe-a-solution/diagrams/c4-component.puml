@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Describe a solution

Container_Boundary(cli, "mvp CLI process") {
  Component(command, "NewDotNetAngularJwtAuthenticatedMvpCommand", "Command factory", "Owns config, name, and output precedence")
  Component(contract, "IMvpManifestLoader", ".NET interface", "Defines manifest loading")
  Component(loader, "YamlMvpManifestLoader", "YamlDotNet adapter", "Reads camel-case YAML and validates the name")
  Component(model, "MvpManifest", "Typed declaration", "Holds entities, pages, and components")
  Component(mapper, "DotNetAngularJwtAuthenticatedMvpGeneratorService", ".NET service", "Maps declarations to factory options")
}
ComponentDb(files, "Local manifest", "YAML file", "Contains the requested solution declaration")

Rel(command, contract, "Calls Load")
Rel(contract, loader, "Implemented by")
Rel(loader, files, "Reads")
Rel(loader, model, "Creates")
Rel(command, model, "Applies overrides")
Rel(command, mapper, "Passes resolved declaration")
@enduml
