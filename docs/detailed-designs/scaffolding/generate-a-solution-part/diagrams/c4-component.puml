@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Generate a solution part

Container_Boundary(cli, "mvp incremental generation") {
  Component(command, "RootCommandFactory action", "Command action", "Creates a typed request from shared options")
  Component(contract, "IIncrementalGenerator", ".NET interface", "Defines all incremental generation")
  Component(renderer, "IncrementalGenerator", "Liquid renderer", "Selects a template plan by GenerationKind")
  Component(output, "ITransactionalGenerationOutput", ".NET interface", "Defines conflict-safe publication")
  Component(writer, "SafeFileWriter", ".NET writer", "Writes contained packaged content")
  Component(process, "IProcessRunner", ".NET interface", "Runs explicit Angular CLI requests")
}
ComponentDb(templates, "Embedded incremental templates", "Package resources", "Solution, project, app, and library content")
ComponentDb(target, "Generated part", "File system", "Selected committed artifacts")

Rel(command, contract, "Calls")
Rel(contract, renderer, "Implemented by")
Rel(renderer, templates, "Reads")
Rel(renderer, output, "Commits through")
Rel(renderer, writer, "Renders through")
Rel(renderer, process, "Uses on explicit opt-in")
Rel(output, target, "Publishes")
@enduml
