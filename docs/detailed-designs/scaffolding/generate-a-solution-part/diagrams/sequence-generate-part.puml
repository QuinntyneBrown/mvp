@startuml
title UML sequence behaviour — Generate one solution part
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Consumer" as actor
participant "Incremental command action" as command
participant "IncrementalGenerator" as generator
participant "TransactionalGenerationOutput" as output
participant "IProcessRunner" as process
database "Embedded templates" as templates
database "Output work area" as files
actor -> command : Select part with name, output, and policy
command -> generator : GenerateAsync(GenerationRequest, token)
generator -> generator : Validate PascalCase name
generator -> output : CommitAsync(target, force, generate, token)
output -> files : Create sibling stage
alt app with --use-angular-cli
  generator -> process : RunAsync(ng, tokenized arguments, stage)
  process --> generator : ProcessResult
else packaged generation
  generator -> templates : Read selected plan content
  generator -> files : Render contained files into stage
end
generator --> output : Stage complete
output -> files : Move stage to target
output --> generator : GenerationResult
generator --> command : Committed artifacts
command --> actor : Exit 0 and target path
@enduml
