@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Generate a solution part

Person(consumer, "Consumer", "Adds one artifact family to a work area")
System(mvp, "mvp", "Generates a selected solution part")
System_Ext(angular, "Angular CLI", "Optionally creates an Angular application")
System_Ext(files, "Local file system", "Stores the generated part")

Rel(consumer, mvp, "Selects a new subcommand", "CLI")
Rel(mvp, angular, "Invokes when available", "Child process")
Rel(mvp, files, "Writes selected artifacts", "Local file I/O")
@enduml
