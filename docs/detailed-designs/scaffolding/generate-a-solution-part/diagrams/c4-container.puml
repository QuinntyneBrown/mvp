@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Generate a solution part

Person(consumer, "Consumer", "Chooses a solution, backend, app, or library command")
System_Boundary(mvp, "mvp") {
  Container(cli, "CLI process", ".NET / System.CommandLine", "Validates a selected part command")
  Container(renderer, "Incremental renderer", "DotLiquid", "Selects packaged .NET 10 and Angular 22 templates")
  Container(output, "Transactional output", ".NET file APIs", "Stages and publishes the selected tree")
  Container(process, "Process runner", ".NET Process", "Runs explicit Angular CLI requests")
}
System_Ext(angular, "Angular CLI", "Optional application generator")
ContainerDb(files, "Output work area", "Local file system", "Receives one committed artifact tree")

Rel(consumer, cli, "Invokes")
Rel(cli, renderer, "Passes GenerationRequest")
Rel(renderer, output, "Renders packaged plan through")
Rel(renderer, process, "Uses only with --use-angular-cli")
Rel(process, angular, "Invokes with ArgumentList")
Rel(output, files, "Publishes")
@enduml
