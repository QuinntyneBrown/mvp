@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Generate a full-stack solution

Container_Boundary(cli, "mvp full-stack generation") {
  Component(command, "RootCommandFactory action", "Command handler", "Loads, validates, and reports")
  Component(model, "ValidatedManifest", "Immutable record", "Carries safe entities, pages, and components")
  Component(contract, "IFullStackGenerator", ".NET interface", "Defines full-stack generation")
  Component(renderer, "FullStackGenerator", "Liquid renderer", "Expands embedded scoped templates")
  Component(output, "TransactionalGenerationOutput", "File adapter", "Stages and atomically publishes")
  Component(writer, "SafeFileWriter", "File adapter", "Contains and normalizes writes")
}
ComponentDb(templates, "Embedded templates", "Package resources", ".NET 10, Angular 22, and Playwright assets")
ComponentDb(tree, "Generated tree", "File system", "backend, frontend, and e2e assets")

Rel(command, model, "Creates after validation")
Rel(command, contract, "Calls")
Rel(contract, renderer, "Implemented by")
Rel(renderer, templates, "Reads manifest and content")
Rel(renderer, output, "Commits through")
Rel(renderer, writer, "Renders files through")
Rel(output, tree, "Publishes")
@enduml
