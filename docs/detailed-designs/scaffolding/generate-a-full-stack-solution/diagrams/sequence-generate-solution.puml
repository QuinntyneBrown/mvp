@startuml
title UML sequence behaviour — Generate the source tree
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Consumer" as actor
participant "Full-stack action" as command
participant "FullStackGenerator" as generator
participant "TransactionalGenerationOutput" as output
database "Embedded templates" as templates
database "Generated solution tree" as tree
actor -> command : Request full-stack generation
command -> generator : GenerateAsync(ValidatedManifest, force, token)
generator -> output : CommitAsync(target, force, render, token)
output -> tree : Create sibling staging directory
output -> generator : Render(stage, token)
generator -> templates : Read template manifest and resources
loop root, entity, page, and component entries
  generator -> generator : Build invariant Liquid tokens
  generator -> tree : SafeFileWriter.WriteAsync(stage, relative path)
end
generator --> output : Render complete
output -> tree : Atomically publish stage
output --> generator : GenerationResult
generator --> command : Artifact count and committed root
command --> actor : Confirm path under L2-021
@enduml
