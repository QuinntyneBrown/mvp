@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Generate a full-stack solution

Person(consumer, "Consumer", "Supplies a validated solution declaration")
System_Boundary(mvp, "mvp") {
  Container(cli, "CLI process", ".NET 10", "Resolves input and reports progress")
  Container(renderer, "Full-stack renderer", "DotLiquid", "Expands tool-owned embedded templates")
  Container(output, "Transactional output", ".NET file APIs", "Stages and publishes complete trees")
}
ContainerDb(templates, "Template resources", "Embedded files", "Backend, frontend, component, page, and test templates")
ContainerDb(files, "Generated solution tree", "Local file system", "Committed backend, frontend, and Playwright assets")

Rel(consumer, cli, "Invokes", "Shell")
Rel(cli, renderer, "Passes ValidatedManifest")
Rel(renderer, templates, "Reads locally")
Rel(renderer, output, "Writes stage through")
Rel(output, files, "Publishes atomically")
@enduml
