@startuml
title UML sequence behaviour — Invoke a generation command
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Consumer" as actor
box "Frontend — Operating-system shell" #E0F2FE
  participant "Shell" as shell
end box
box "Backend — mvp CLI application" #D1FADF
  participant "RootCommand" as root
  participant "RootCommandFactory action" as command
  participant "CliExceptionPolicy" as policy
end box
box "Backend — Generation application" #ECFDF3
  participant "Generator boundary" as generator
end box
actor -> shell : Enter mvp new command
shell -> root : Start with arguments
root -> root : Parse command and options
root -> command : Dispatch with cancellation token
command -> policy : ExecuteAsync(operation)
policy -> generator : GenerateAsync(validated input)
alt success
  generator --> policy : GenerationResult
  policy --> command : 0
else validation / conflict / generation / internal / cancellation
  generator --> policy : Typed exception
  policy --> command : 1 / 2 / 3 / 70 / 130
end
command --> root : Exit code
root --> shell : Return code and bounded output
shell --> actor : Present result
@enduml
