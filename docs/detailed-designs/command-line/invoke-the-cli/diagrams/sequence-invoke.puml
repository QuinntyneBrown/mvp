@startuml
title UML sequence behaviour — Invoke a generation command
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Consumer" as actor
box "Frontend — Operating-system shell" #E0F2FE
  participant "Shell" as shell
end box
box "Backend — mvp CLI application" #D1FADF
  participant "RootCommand" as root
  participant "Selected command" as command
end box
box "Backend — Generation services" #ECFDF3
  participant "Generator service" as generator
end box
box "Backend — Local infrastructure" #FFF4E5
  database "Output directory" as output
end box
actor -> shell : Enter mvp new command
shell -> root : Start process with arguments
root -> root : Parse command and L2-004 options
root -> command : Dispatch selected handler
command -> generator : GenerateAsync(resolved input)
generator -> output : Write selected artifacts
output --> generator : Write result
generator --> command : Completed
alt generation succeeds
  command --> root : Return normally
  root --> shell : Exit 0 under L2-003
else parsing or generation fails
  command --> root : Report bounded failure
  root --> shell : Exit non-zero under L2-003
end
shell --> actor : Present help, progress, or failure
@enduml
