@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Invoke the CLI

Person(consumer, "Consumer", "Chooses a generation command")
Container_Boundary(cli, "mvp CLI process") {
  Component(program, "Program", ".NET composition root", "Builds the host and invokes the root command")
  Component(root, "RootCommand", "System.CommandLine", "Owns product help and top-level parsing")
  Component(factory, "RootCommandFactory", "Command factory", "Builds the new group, options, and actions")
  Component(policy, "CliExceptionPolicy", ".NET policy", "Maps failures to stable exit codes")
  Component(generator, "Generator boundary", ".NET interface", "Executes full-stack or incremental generation")
}

Rel(consumer, root, "Invokes")
Rel(program, root, "Constructs and runs")
Rel(root, factory, "Contains commands built by")
Rel(factory, policy, "Runs actions through")
Rel(factory, generator, "Calls with validated input")
@enduml
