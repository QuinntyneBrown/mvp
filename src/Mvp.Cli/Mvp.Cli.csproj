<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mvp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mvp</ToolCommandName>
    <PackageId>Mvp.Cli</PackageId>
    <Version>2.0.0</Version>
    <Authors>Quinntyne Brown</Authors>
    <Description>Scaffolds maintainable .NET and Angular MVP solutions from a validated manifest.</Description>
    <PackageTags>dotnet-tool;scaffolding;angular;aspnetcore;mvp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/QuinntyneBrown/mvp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/QuinntyneBrown/mvp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RootNamespace>Mvp.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotLiquid" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Templates\**\*" />
  </ItemGroup>

</Project>
