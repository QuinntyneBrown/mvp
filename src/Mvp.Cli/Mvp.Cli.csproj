<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mvp</AssemblyName>
    <RootNamespace>Mvp.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mvp</ToolCommandName>
    <PackageId>Mvp.Cli</PackageId>
    <Title>mvp</Title>
    <Description>Scaffolds maintainable .NET and Angular MVP solutions from a validated manifest.</Description>
    <PackageTags>dotnet-tool;scaffolding;angular;aspnetcore;mvp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mvp.Core\Mvp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
