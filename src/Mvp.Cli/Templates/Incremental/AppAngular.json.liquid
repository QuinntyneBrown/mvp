{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "{{NameKebab}}-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/{{NameKebab}}-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.scss"]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "{{NameKebab}}-app:build" } }
      }
    }
  }
}
