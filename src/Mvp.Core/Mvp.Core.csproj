<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AssemblyName and RootNamespace are pinned equal to each other. Embedded template
         resource names derive from RootNamespace, and the generators derive their lookup
         prefix from the assembly; TemplateResourceTests enforces that they agree. -->
    <AssemblyName>Mvp.Core</AssemblyName>
    <RootNamespace>Mvp.Core</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Packaging metadata (PackageId QuinntyneBrown.Mvp.Core) lands once the extraction
         is proven; see RELEASE.md. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotLiquid" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*" WithCulture="false" />
  </ItemGroup>

</Project>
